{
    "document_type": "giay_chung_tu",
    "document_name": "Giấy chứng tử",
    "start_triggers": [
        "GIẤY CHỨNG TỬ"
    ],
    "start_threshold": 85,
    "radar_lines": 35,
    "exclude_triggers": [
    ],
    "end_triggers": [
        "NGƯỜI KÝ BẢN SAO GIẤY CHỨNG TỬ"
    ],
    "end_threshold": 85,
    
    "extraction_rules": [
        {
            "field_name": "so_ky_hieu_tai_lieu",
            "extraction_method": "global_regex",
            "pattern": "(?i)s[ốổoO][\\s:.,\\-]*([0-9a-zA-Z\\s]+/\\s*[0-9a-zA-Z]{4})",
            "data_type": "string"
        },
        {
            "field_name": "ngay_thang_van_ban",
            "extraction_method": "proximity_number_search",
            "anchor_keywords": [
                "NGƯỜI KÝ BẢN SAO GIẤY CHỨNG TỬ",
                "ghi rõ họ tên"
            ],
            "scan_limit": 15,
            "scan_direction": "bottom_up",
            "look_up_lines": 3,
            "context_direction": "above",
            "date_format_mode": "text_only",
            "post_processing": [
                "fix_ocr_date_typos",
                "clean_targeted_punctuation",
                "extract_date_from_mixed_text"
            ]
        },
        {
            "field_name": "ten_loai_tai_lieu",
            "extraction_method": "fixed_string_with_conditional_append",
            "base_string": "Giấy chứng tử",
            "conditions": [
                {
                    "keyword": "THU HỒI",
                    "append_string": " (Đã thu hồi)",
                    "threshold": 80
                },
                {
                    "keyword": "BẢN SAO",
                    "append_string": " (Bản sao)",
                    "threshold": 80
                },
                {
                    "keyword": "BANSAO",
                    "append_string": " (Bản sao)",
                    "threshold": 80
                }
            ],
            "data_type": "string"
        },
        {
            "field_name": "tac_gia",
            "extraction_method": "global_regex",
            "pattern": "(?is).*ch[ủu]\\s*t[iị!1]ch[\\s:.,\\-]*([^\\n]{5,})",
            "post_processing": [
                "clean_targeted_punctuation"
            ],
            "data_type": "string"
        }
    ]
}